{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@project/*": ["./*"],
      "@locations/*": ["./locations/*"],
      "@global/*": ["./global/*"],
      "@plugins/*": ["./plugins/*"],
      "@generate/*": ["./generate/*"]
    }
  },
  "include": ["locations", "global", "plugins"],
  "exclude": ["node_modules", "dist", "generate"]
}
